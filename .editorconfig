root = true

[*]
# Stated for every file because these two are the only editor settings that must agree
# across every contributor: they are what `.gitattributes` already enforces for the
# tracked text types, and a file edited on Windows must not come back with CRLF or no
# terminating newline. Submodule sources are excluded - they are upstream files, and
# reformatting them is not ours to do.
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[app/src/main/cpp/opus/**]
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset

[app/src/main/cpp/ogg/**]
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset

[app/src/main/cpp/libopusenc/**]
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset

[*.{kt,kts}]
# Compose names composable functions in PascalCase. That is the convention the Compose
# compiler follows and the one every Compose codebase uses, and it conflicts with the
# function-naming rule. ktlint provides a setting for exactly this case, so the rule is
# taught the exception instead of being suppressed per finding or worked around by
# renaming functions into something nobody would write.
#
# Nothing else is set here on purpose. Stating `max_line_length` or `indent_size` was
# tried and it changed how ktlint wraps existing code, which turned a two-file Compose
# change into a 160-line reformat of unrelated files. A configuration file that silently
# restates the defaults is not free; this one only says the thing that is actually
# different.
ktlint_function_naming_ignore_when_annotated_with = Composable