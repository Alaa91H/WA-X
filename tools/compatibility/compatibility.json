{
  "schemaVersion": 1,
  "title": "WA X compatibility matrix",
  "purpose": "Single source of truth for WA X target compatibility decisions. Declared target versions are not resolver evidence. Curated matrix/evidence data is maintained manually; derived data is regenerated from the source tree.",
  "statusVocabulary": {
    "supported": "Every resolver this feature depends on was observed to resolve on this exact target, at runtime, with evidence recorded under evidence.",
    "degraded": "The feature loads, but at least one required resolver failed and the feature fell back to a legacy or partial path.",
    "unsupported": "A required resolver is known not to resolve on this target. The feature must not be enabled.",
    "unknown": "No resolver evidence has been collected for this cell yet. This is the only status permitted without evidence."
  },
  "evidencePolicy": {
    "rule": "A supported version cell requires a packages.<target>.certifiedBuildFingerprints[exactVersion] entry declaring the expected build identity separately from observations, plus matching exact-target evidence and each required resolver verified resolved at runtime. Missing or drifted fingerprints fail closed. Version-wide status does not prove other Android users/accounts or feature behavior.",
    "enforcedBy": "tools/compatibility/validate_compatibility.py",
    "collectedAtRuntimeBy": "T51+ diagnostics; until then no cell may claim supported"
  },
  "resolutionTiers": {
    "none": {
      "meaning": "The feature references no internal resolution layer (Unobfuscator, ReflectionUtils, WppCore). It is driven purely by preferences or its own UI.",
      "structurallyIndependent": true,
      "note": "Structurally independent features cannot break on a WhatsApp update through resolution. They are still listed so the inventory stays complete."
    },
    "indirect": {
      "meaning": "The feature resolves hook targets through ReflectionUtils or WppCore but calls no Unobfuscator resolver directly.",
      "structurallyIndependent": false
    },
    "dexkit": {
      "meaning": "The feature calls one or more Unobfuscator DexKit resolvers directly and therefore needs resolver evidence.",
      "structurallyIndependent": false
    }
  },
  "module": {
    "minSdk": 28,
    "targetSdk": 34,
    "compileSdk": 37,
    "abis": [
      "arm64-v8a",
      "armeabi-v7a"
    ],
    "sdkDimension": {
      "note": "A feature that resolves a native or framework symbol may still be constrained by API level. Per-feature SDK constraints are recorded in matrix overrides using the sdk key and are enforced by the validator.",
      "example": "\"matrix\": { \"CallRecording\": { \"sdk\": { \"below28\": \"unsupported\" } } }"
    },
    "abiDimension": {
      "note": "Native-backed features (Opus audio conversion) are constrained by the packaged ABIs. Per-feature ABI constraints use the abi key."
    }
  },
