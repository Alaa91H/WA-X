{
  "schemaVersion": 1,
  "philosophy": "Fail closed. No warning, uncovered production path, unverified latest-target feature, hidden/broken option, or stale generated contract may ship.",
  "coverage": {
    "unit": {
      "instruction": 100,
      "branch": 100,
      "line": 100,
      "complexity": 100,
      "method": 100,
      "class": 100
    },
    "e2e": {
      "instruction": 100,
      "branch": 100,
      "line": 100,
      "complexity": 100,
      "method": 100,
      "class": 100
    }
  },
  "latestCompatibility": {
    "targets": [
      "whatsapp",
      "business"
    ],
    "requiredFeatureResult": "passed",
    "requiredPreferenceResult": "passed",
    "maxEvidenceAgeDays": 14,
    "requireExactModuleCommit": true,
    "requireApkSha256": true
  },
  "ui": {
    "forbidDuplicateKeys": true,
    "forbidEnabledFalsePlaceholders": true,
    "forbidHardcodedPreferenceText": true,
    "requireEveryPreferenceRuntimeReference": true
  },
  "codeQuality": {
    "warningsAsErrors": true,
    "allowLintBaseline": false,
    "allowDetektBaseline": false,
    "kotlinWarningsAsErrors": true,
    "javaWarningsAsErrors": true,
    "nativeWarningsAsErrors": true
  }
}
